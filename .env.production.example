# Identificador único de instancia (crm, cliente1, empresa-alfa, etc.)
CRM_INSTANCE_NAME=crm

# Dominio público configurado en DNS y Nginx Proxy Manager
APP_URL=https://crm.unitepc.pro
SANCTUM_STATEFUL_DOMAINS=crm.unitepc.pro,unitepc.pro
CORS_ALLOWED_ORIGINS=https://crm.unitepc.pro,https://unitepc.pro

# Llave de cifrado de Laravel (32 bytes base64)
APP_KEY=base64:CyU1JHIJ1c4G7un/AMwKEf76+5Vp8zn9Gatjb8GeqWI=
APP_DEBUG=false
APP_ENV=production

# Base de datos PostgreSQL
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=crm_secret_2026

# Nombre de la red de Nginx Proxy Manager en el servidor
PROXY_NETWORK=red-proxy

# Cargar datos iniciales de demo en el primer despliegue (true/false)
SEED_DEMO=true
