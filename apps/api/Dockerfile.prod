FROM php:8.3-cli-alpine

# Install system dependencies, PostgreSQL dev libraries, and extensions
RUN apk add --no-cache \
    postgresql-dev \
    sqlite-dev \
    libzip-dev \
    linux-headers \
    git \
    unzip \
    curl \
    netcat-openbsd \
    $PHPIZE_DEPS \
    && docker-php-ext-install pdo pdo_pgsql pgsql pdo_sqlite bcmath pcntl zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del $PHPIZE_DEPS

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy application code
COPY . .

# Install composer dependencies for production
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

# Ensure proper directories and permissions
RUN mkdir -p storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 8010

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8010"]
